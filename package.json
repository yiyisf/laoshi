{
  "name": "laoshi",
  "version": "0.1.0-dev",
  "private": true,
  "description": "laoshi: a platform-neutral requirement-development workflow, extracted from paseo-req-kit. M1: req-kit 1.15.0's core with the Paseo adapter; not published yet.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyisf/laoshi.git"
  },
  "engines": {
    "node": ">=22"
  },
  "reqKit": {
    "paseo": ">=0.11.0 <0.12.0"
  },
  "bin": {
    "laoshi": "bin/req.mjs",
    "req": "bin/req.mjs",
    "start-pipeline": "bin/start-pipeline.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./engine/test/isolate.ts --test --test-concurrency=1 --test-timeout=300000 engine/test/*.test.ts adapters/*/test/*.test.ts test/*.test.ts",
    "smoke": "tsx engine/src/smoke-test.ts",
    "doctor": "node bin/req-doctor.mjs",
    "eval": "tsx engine/src/eval.ts",
    "eval:self-check": "tsx engine/src/eval.ts --reference",
    "tokens": "node scripts/tokens-build.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "^0.11.2",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
