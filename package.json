{
  "name": "laoshi",
  "version": "0.1.0",
  "description": "laoshi：给测试、产品、项目经理用的需求开发体系。在 agent 平台（Paseo、DeepSeek Harness）的对话中对齐需求，由一组 AI agent 在后台完成设计、实现、评审和验证。",
  "type": "module",
  "license": "MIT",
  "homepage": "https://yiyisf.github.io/laoshi/",
  "bugs": {
    "url": "https://github.com/yiyisf/laoshi/issues"
  },
  "keywords": [
    "requirements",
    "ai-agent",
    "pipeline",
    "paseo",
    "deepseek",
    "dsh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiyisf/laoshi.git"
  },
  "engines": {
    "node": ">=22"
  },
  "reqKit": {
    "paseo": ">=0.11.0 <0.12.0"
  },
  "bin": {
    "laoshi": "bin/req.mjs",
    "req": "bin/req.mjs",
    "start-pipeline": "bin/start-pipeline.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --import ./engine/test/isolate.ts --test --test-concurrency=1 --test-timeout=300000 engine/test/*.test.ts adapters/*/test/*.test.ts test/*.test.ts",
    "smoke": "tsx adapters/paseo/smoke-test.ts",
    "doctor": "node bin/req-doctor.mjs",
    "eval": "tsx engine/src/eval.ts",
    "eval:self-check": "tsx engine/src/eval.ts --reference",
    "tokens": "node scripts/tokens-build.mjs"
  },
  "dependencies": {
    "@getpaseo/client": "^0.11.2",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "bin/",
    "engine/src/",
    "engine/prompts/",
    "engine/skill-fragments/",
    "adapters/*/*.ts",
    "adapters/*/*.mjs",
    "adapters/*/skill/**",
    "adapters/dsh/plugin/",
    "adapters/dsh/intranet/",
    "skills/",
    "principles/",
    "contracts/",
    "notifiers/",
    "docs/guide/",
    "docs/adr/",
    "docs/design/",
    "docs/intranet/",
    "site-dist/",
    "config.example.json",
    "CHANGELOG.md",
    "SCOPE.md",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
